# DRISHTI .env example
# Copy this file to .env and fill in your credentials for live mode.

# Telegram bot credentials (required for live emergency uplink)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Gemini API key (optional; offline tactical fallback runs without it)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: venue and vehicle defaults (overridden by state.py if left blank)
VEHICLE_ID=BR-01-EXP-2026
VENUE_LAT=25.6193
VENUE_LON=85.1415